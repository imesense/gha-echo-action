{
  "$schema": "https://www.schemastore.org/package",
  "name": "gha-echo-action",
  "version": "0.2.0",
  "description": "Simple action for printing input to output",
  "author": "acidicMercury8",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "scripts": {
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "start": "npx tsx ./node_modules/@github/local-action/src/index.ts . ./src/Action.js .env",
    "test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
    "pack": "npx rollup --config rollup.config.js",
    "pack:watch": "npm run package -- --watch"
  },
  "homepage": "https://github.com/imesense/gha-echo-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imesense/gha-echo-action.git"
  },
  "bugs": {
    "url": "https://github.com/imesense/gha-echo-action/issues"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@actions/core": "3.0.0",
    "@actions/github": "9.0.0"
  },
  "devDependencies": {
    "@github/local-action": "7.0.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "eslint": "9.39.2",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "prettier-plugin-brace-style": "0.9.0",
    "rollup": "4.57.1",
    "rollup-plugin-license": "3.7.0",
    "tsx": "4.21.0"
  }
}
